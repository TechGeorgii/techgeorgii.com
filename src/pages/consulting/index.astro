---
import BaseLayout from "../../layouts/BaseLayout.astro";

const telegram = "https://t.me/georgiisavchenko";
const max = "https://max.ru/u/f9LHodD0cOJp5XmCDwhtRbeR3PWpvgSvoAVszuL5cy64aNbt8QhSTEBy_A0";

const pains = [
  "Темп разработки медленный – конкуренты идут вперед, а вы месяц делаете одну фичу?",
  "Постоянные технические проблемы у клиентов, которые влияют на продажи?",
  "Вам хочется заниматься развитием бизнеса и продавать, но приходится отвлекаться на тех часть?",
  "CTO говорит, что все хорошо, но Вам хочется быстрее и качественнее?",
];

const causes = [
  {
    title: "Команда не работает, как единое целое",
    text: "Фаундер не уделяет время проекту, ключевые роли (например, продакт менеджер) не закрыты, разработчики по психотипу не соответствуют своим задачам",
  },
  {
    title: "Отсутствует процесс планирования и постановки задач",
    text: "Задачи в голове у руководства – не то же самое, что в голове у разработчика. Темп и регулярность отсутствуют",
  },
  {
    title: "Техдолг",
    text: "Груда накопившихся старых решений, принятых на прошлых стадиях, не дают команде быстро итерировать, а времени на исправления нет (и не понятно, что конкретно нужно поправить)",
  },
  {
    title: "Низкая стабильность продукта",
    text: "Команда тушит пожары, вместо того, чтобы двигаться по роадмэпу – а времени на стабилизацию нет",
  },
  {
    title: "Техническая и нетехническая части команды не понимают друг друга",
    text: 'У "технарей" – своя атмосфера, у маркетинга – своя, и не понятно, как их связать вместе',
  },
];

const about = [
  { text: "Технический + менеджерский бэкграунд" },
  {
    before: "Основал и руководил компанией заказной разработки Аспирити",
    link: { href: "https://aspirity.ru/about" },
    after: ", 100+ М руб выручки в год",
  },
  { text: "Онбордил крупных и иностранных клиентов" },
  { text: "Собственноручно нанял 50+ разработчиков, собрал 20+ команд проектов" },
  { text: "Два раза нанял операционного директора в компанию" },
  { text: "Основал 3 стартапа, один из них AI-first" },
  { text: "Собственноручно закупал трафик и настраивал рекламу" },
  { text: "Участвовал в пресейле для Google (да, для того самого)" },
  { text: 'Опыт в разработке "руками" 10+ лет, в том числе в международной VC-backed компании' },
];

const services = [
  {
    title: "Построю процесс планирования и постановки задач",
    text: "Возможно ключевой вопрос, помогающий сильно повысить эффективность развития продукта. Обычно разработчики работают медленно не потому, что не хотят, а потому что не понимают, что точно делать. Внедрю спринты, систему трекинга задач без излишней бюрократии.",
  },
  {
    title: "Разберусь с техдолгом",
    text: "Проанализирую систему на уровне кода, логов и метрик. Предоставлю отчет о техдолге, насколько он влияет на бизнес компании, дам оценку приоритетов и сроков исправления",
  },
  {
    title: "Помогу собрать команду",
    text: "Проведу интервью с членами команды (как техническими так и нетехническими). Определю проблемы взаимодействия, ожидания сторон, предложу наймы и / или сокращения",
  },
  {
    title: "Помогу поправить долгосрочные проблемы",
    text: "Разберусь, что постоянно отваливается у пользователя. Добавлю мониторинг, контекстный логгинг и алертинг – все, чтобы ваше приложение было под постоянным наблюдением",
  },
];

const steps = [
  {
    title: "Звонок-знакомство – полчаса-час",
    text: "Первое знакомство. На звонке мы поймем Ваши боли, проблемы и цели",
  },
  {
    title: "Подписание NDA и бесплатный аудит компании",
    text: "Сначала мы подписываем соглашение о неразглашении. Далее вы присылаете материалы для проведения аудита – записи звонков планирования, доступ к исходному коду, доступ в систему планирования задач, еще что-то. Это нужно, чтобы составить подробную картину",
  },
  {
    title: "Презентация вариантов решения и вилки трудозатрат и стоимости",
    text: "Фокусируемся на проблеме, решение которой может дать результат относительно быстро и построить доверие. Фиксируем формат, длительность и процент вовлечения, заключаем договор",
  },
  {
    title: "Расширенный аудит, создание дорожной карты",
    text: "Провожу интервью со стейкхолдерами и сотрудниками, вливаюсь в процессы компании, изучаю техническую часть. В результате строю дорожную карту работ. Описываем финальное желаемое состояние – настроенные процессы, закрытые роли и тд.",
  },
  {
    title: "Работа по дорожной карте",
    text: "Иду по дорожной карте, включаюсь в рабочие процессы, по возможности делегирую Вашим сотрудникам для ускорения и уменьшения стоимости.",
  },
  {
    title: "Регулярные синки",
    text: "Проводим еженедельные встречи, на которых обсуждаем результат работы и достигнутые результаты",
  },
];

const faq = [
  {
    q: "Сколько стоят услуги? Я плачу фиксированную цену?",
    a: "Это услуга с почасовой тарификацией согласно заранее обговоренной вилке по задачам (например, я могу проводить интервью с сотрудниками компании, настраивать алерты или Яндекс Метрику, участвовать в планировании спринтов)",
  },
  {
    q: "Почему нет фиксированного тарифа?",
    a: "Все компании очень разные, и невозможно оценить работу фиксированно",
  },
  {
    q: "Зачем мне платить вам за техническую работу, хотя мой разработчик может сделать это гораздо дешевле?",
    a: "Работа включает также организационную и продуктовую части. Для разработчика – например, настройка логгинга – всего лишь задача, но для меня это удовлетворенность пользователей и стабильность бизнеса",
  },
  {
    q: "Почему я не могу попросить текущих сотрудников исправить проблемы?",
    a: 'Сотрудники обычно заняты оперативной работой, от которой их сложно отвлечь. Более того, обычно в команде есть технические специалисты, есть продуктовые, но они говорят на разных языках и не могут понять друг друга. За счет бизнес и технического опыта я могу "подружить" их друг с другом.',
  },
  {
    q: "Какой критерий завершения взаимодействия и могу ли я закончить в любой момент?",
    a: "Да, Вы можете прекратить сотрудничество в любой момент. По критерию завершения взаимодействия – моя задача дать Вам систему, помочь принять управленческие решения, заполнить роли правильными людьми. Когда это сделано, далее требуется только периодические консультации.",
  },
  {
    q: "Мы работали с консультантами по менеджменту, остались недовольны. Почему именно вы можете помочь?",
    a: "Я могу не только нарисовать идеальную картину будущего, но и внедрить изменения своими руками. 10+ лет опыта в менеджменте и 10+ лет в разработке. Пишу код руками и агентами последние 4 года. Работал линейным сотрудником уже имея управленческий опыт – изнутри знаю, что нужно команде и почему сотрудники могут быть неэффективны.",
  },
  {
    q: 'Вы оказываете услугу "под ключ"? Я могу заказать и не беспокоиться ни о чем?',
    a: "Без вовлечения Вашего и сотрудников ничего не получится. Вам и Вашей организации, скорее всего, придется менять процессы и меняться самим. Настраивайтесь на долгосрочную работу.",
  },
  {
    q: "Что с ИИ? Сейчас все его внедряют",
    a: "Я внедряю ИИ, но это всего лишь инструмент. Практика показывает, что корневые проблемы компаний – в стратегических, организационных и процессных моментах. После того, как они стабилизированы, можно улучшать и ускорять процессы внедрением ИИ агентов.",
  },
];

const cases = [
  {
    title: '"Пересбор команды"',
    text: 'Нетехнический фаундер, два разработчика и дизайнер – не "заводился" проект. Анализ показал, что отсутствует "якорный" разработчик, один из сотрудников был с небольшим опытом и не мог выполнять якорную роль, второй участвовал парт-тайм и также не подходил. В результате c одним сотрудником расстались, был найден ведущий разработчик в качестве лида и наставника менее опытного. Был поставлен процесс еженедельного планирования',
  },
  {
    title: "Выстроено управление продуктом",
    text: "Компания, 3 разработчика, UI дизайнер, маркетинговый отдел 3 человека. Собственник компании не вовлекался в процессы, кроме еженедельных звонков. Роль продакт менеджера отсутствовала. Разработка простаивала без задач, маркетинг не понимал, когда будут результаты. Выстроил процесс постановки задач за счет внедрения в команду роли лида/продакт менеджера, который служил промежуточным звеном между бизнесом и технической командой. В результате команда вышла на нужный темп.",
  },
  {
    title: "Внедрение ИИ-процессов",
    text: 'Была настроена связка ИИ-агентов с хранилищем метрик приложения на основе Clickhouse. Нетехнические пользователи получили возможность извлекать данные не обращаясь к "технарям". Были настроены стенды для отдела маркетинга и дизайна для внесения мелких правок через ИИ-агенты, что позволило разгрузить разработку от мелких задач и повысить скорость реакции на фидбек пользователей.',
  },
];
---
<BaseLayout
  title="Консалтинг"
  description="Фокусируйтесь на бизнесе, а не технических деталях. Для фаундеров, управленцев и директоров digital-продуктов."
  lang="ru"
  minimal
>
  <article class="offer">
    <p class="eyebrow">// consulting</p>
    <h1>Фокусируйтесь на бизнесе,<br />а не технических деталях</h1>
    <p class="lede">Для фаундеров, управленцев и директоров digital-продуктов</p>

    <section>
      <h2><span class="tag">01</span> Знакомо?</h2>
      <ul class="tight">
        {pains.map((p) => <li>{p}</li>)}
      </ul>
      <p class="note">Большинство таких проблем имеют причины на пересечении менеджмента и ИТ</p>
    </section>

    <section>
      <h2><span class="tag">02</span> Типовые причины проблем</h2>
      <div class="collapse">
        {causes.map((c) => (
          <details>
            <summary>{c.title}</summary>
            <p>{c.text}</p>
          </details>
        ))}
      </div>
    </section>

    <section>
      <h2><span class="tag">03</span> Кто я и как могу Вам помочь</h2>
      <div class="about">
        <div class="about-photo">
          <img src="/georgii.jpg" alt="Гоша" width="180" height="180" />
          <div class="about-messengers">
            <a class="msg-btn msg-telegram" href={telegram} target="_blank" rel="noopener" aria-label="Telegram">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </a>
            <a class="msg-btn msg-max" href={max} target="_blank" rel="noopener" aria-label="Max">
              <img src="/max.svg" alt="" width="16" height="16" />
            </a>
          </div>
        </div>
        <div>
          <p class="about-lead">Я – Гоша, предприниматель и разработчик</p>
          <details>
            <summary>Опыт</summary>
            <ul class="tight">
              {about.map((a) => (
                <li>
                  {"text" in a ? (
                    a.text
                  ) : (
                    <>
                      {a.before}
                      <a class="ext-link" href={a.link.href} target="_blank" rel="noopener" aria-label="Аспирити">
                        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6v2H7v10h10v-4h2v6H5V5z"/></svg>
                      </a>
                      {a.after}
                    </>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
      <p class="note">Моя миссия – помогать предпринимателям строить эффективные цифровые компании. Цель – дать Вам возможность сфокусироваться на бизнесе, а не на разработке</p>
    </section>

    <section>
      <h2><span class="tag">04</span> Что могу сделать, чтоб решить Ваши проблемы</h2>
      <div class="collapse">
        {services.map((s) => (
          <details>
            <summary>{s.title}</summary>
            <p>{s.text}</p>
          </details>
        ))}
      </div>
    </section>

    <section>
      <h2><span class="tag">05</span> Процесс работы</h2>
      <p class="note">(может меняться, тк все компании разные)</p>
      <div class="collapse">
        {steps.map((s, i) => (
          <details>
            <summary>{i + 1}. {s.title}</summary>
            <p>{s.text}</p>
          </details>
        ))}
      </div>
    </section>

    <section>
      <h2><span class="tag">06</span> Вопрос-ответ</h2>
      <div class="collapse">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section>
      <h2><span class="tag">07</span> Кейсы</h2>
      <div class="collapse">
        {cases.map((c) => (
          <details>
            <summary>{c.title}</summary>
            <p>{c.text}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="cta-block">
      <h2>Записаться на консультацию</h2>
      <div class="cta">
        <a class="btn btn-telegram" href={telegram} target="_blank" rel="noopener">
          <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          Telegram
        </a>
        <a class="btn btn-max" href={max} target="_blank" rel="noopener">
          <img class="btn-icon" src="/max.svg" alt="" width="20" height="20" />
          Max
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .offer {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .eyebrow,
  .tag {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
  }
  .offer h1 {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: clamp(1.65rem, 4vw, 2.15rem);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }
  .lede {
    color: var(--muted);
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }
  .offer h2 {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }
  .tag {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-weight: 400;
    flex-shrink: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border: 1px solid transparent;
    text-decoration: none;
    font-size: 0.88rem;
    border-radius: 4px;
    color: #fff;
  }
  .btn:hover {
    opacity: 0.9;
  }
  .btn-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    display: block;
    border-radius: 3px;
  }
  .btn-telegram {
    background: #2aabee;
    border-color: #2aabee;
  }
  .btn-max {
    background: #0d001a;
    border-color: #471aff;
  }
  .tight {
    margin: 0.5rem 0 0;
    padding-left: 1.15rem;
  }
  .tight li {
    margin: 0.4rem 0;
  }
  .ext-link {
    display: inline-flex;
    align-items: center;
    vertical-align: -0.1em;
    margin: 0 0.15em;
    color: var(--link);
    text-decoration: none;
  }
  .ext-link:hover {
    opacity: 0.85;
  }
  .ext-link svg {
    display: block;
  }
  .note {
    color: var(--muted);
    margin: 1rem 0 0;
    font-size: 0.85rem;
  }
  .about {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .about-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }
  .about-photo img {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border);
    margin: 0;
  }
  .about-messengers {
    display: flex;
    gap: 0.4rem;
  }
  .msg-btn {
    display: inline-flex;
