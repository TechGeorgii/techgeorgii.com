---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  minimal?: boolean;
}
const { title, description = "TechGeorgii", lang = "en", minimal = false } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <script is:inline>
      (function () {
        var s = localStorage.getItem("theme");
        document.documentElement.dataset.theme =
          s === "light" || s === "dark" ? s : "dark";
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class:list={["site-header", { "site-header-minimal": minimal }]}>
      {!minimal && <a class="brand" href="/">TechGeorgii</a>}
      <div class="site-header-right">
        {!minimal && (
          <nav>
            <a href="/about-me/">About</a>
          </nav>
        )}
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle light or dark theme"
        >
          <span class="theme-icon theme-icon-sun" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </span>
          <span class="theme-icon theme-icon-moon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          </span>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", function () {
        var html = document.documentElement;
        var next = html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0f1115;
    --text: #e8eaed;
    --muted: #9aa0a6;
    --link: #7cb3ff;
    --border: #2a2f38;
    --code-bg: #1a1d24;
  }
  html[data-theme="light"] {
    color-scheme: light;
    --bg: #f7f5f0;
    --text: #1c1d21;
    --muted: #5c5f66;
    --link: #0b57d0;
    --border: #dad6ce;
    --code-bg: #ebe8e2;
  }
  * {
    box-sizing: border-box;
  }
  html {
    font-family: "Source Serif 4", Georgia, serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
    font-size: 18px;
  }
  body {
    margin: 0;
    min-height: 100vh;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    max-width: 48rem;
    margin: 0 auto;
  }
  .site-header-minimal {
    justify-content: flex-end;
  }
  .brand {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .site-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    border-radius: 6px;
  }
  .theme-toggle:hover {
    color: var(--link);
    background: var(--code-bg);
  }
  .theme-icon {
    display: none;
    line-height: 0;
  }
  html[data-theme="dark"] .theme-icon-sun {
    display: block;
  }
  html[data-theme="light"] .theme-icon-moon {
    display: block;
  }
  .site-header a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-header a:hover {
    color: var(--link);
  }
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .article-meta {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }
  article h1 {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  article h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 2.25rem 0 1rem;
  }
  article p {
    margin: 1rem 0;
  }
  article a {
    color: var(--link);
  }
  article ol,
  article ul {
    padding-left: 1.35rem;
  }
  article li {
    margin: 0.35rem 0;
  }
  article img {
    display: block;
    max-width: 100%;
    height: auto;
    margin-left: auto;
    margin-right: auto;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  article figure {
    margin: 1.5rem auto;
    text-align: center;
  }
  article figure img {
    display: inline-block;
    margin-left: auto;
    margin-right: auto;
  }
  article p:has(img) {
    text-align: center;
  }
  article pre {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    line-height: 1.5;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
  }
  article code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 0.12em 0.35em;
    border-radius: 4px;
  }
  article pre code {
    padding: 0;
    background: none;
    font-size: inherit;
  }
  article em {
    font-style: italic;
  }
  article strong {
    font-weight: 600;
  }
  .home-list {
    list-style: none;
    padding: 0;
  }
  .home-list li {
    margin: 0.75rem 0;
  }
  .home-list a {
    color: var(--link);
  }
  .post-index {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .post-index li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin: 0.55rem 0;
    line-height: 1.45;
  }
  .post-index time {
    color: var(--muted);
    font-size: 0.88em;
    font-variant-numeric: tabular-nums;
    min-width: 6.75rem;
    flex-shrink: 0;
  }
  .post-index a {
    color: var(--link);
    flex: 1;
    min-width: min(100%, 12rem);
  }
</style>
